# Copy to .env (git-ignored) for local runs, or set as GitHub Actions secrets.

# LINE OA channel access token (Messaging API). Required to actually send.
LINE_CHANNEL_ACCESS_TOKEN=

# "broadcast" = all OA followers; or a LINE userId / groupId to push to.
LINE_TARGET=broadcast

# Set to 1/true to print results instead of sending (also implied if no token).
DRY_RUN=
